# strangrchat environment variables example

# Environment & Server
NODE_ENV=production
PORT=3000
DOMAIN=api.strangrchat.com

# PostgreSQL Configuration
POSTGRES_USER=strangr
POSTGRES_PASSWORD=strangr_secure_password_change_me
POSTGRES_DB=strangrchat_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT / Auth Secrets
JWT_SECRET=change_this_to_a_random_jwt_secret_32_chars_min

# Google Play Integrity & Billing API
GOOGLE_PLAY_PACKAGE_NAME=com.strangrchat.app
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/app/google-service-account.json
